	Button.MouseButton1Click:Connect(function()

		Sound:Play()

		local CurrentPage = Frame:GetAttribute("CurrentPage") or 1
		local SlotNumber = ((CurrentPage - 1) * 6) + i

		if SlotNumber <= 15 then

			local Success, ErrorMessage = pcall(function()
				ScriptSlots[SlotNumber]()
			end)

			if not Success then
				warn(
					"خطأ في الخانة "
					..SlotNumber
					..": "
					..tostring(ErrorMessage)
				)
			end
		end
	end)

	Buttons[i] = {
		Button = Button,
		Label = Label
	}
end

