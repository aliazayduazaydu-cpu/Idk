--// =========================================
--// تغيير الصفحة
--// =========================================

local function ChangePage(Page)

	Frame:SetAttribute("CurrentPage",Page)
	PageTitle.Text = "القائمة "..Page

	for i = 1,6 do

		local SlotNumber = ((Page - 1) * 6) + i

		if SlotNumber <= 15 then
			Buttons[i].Button.Visible = true
			Buttons[i].Label.Text = ScriptNames[SlotNumber]
		else
			Buttons[i].Button.Visible = false
		end
	end

	for PageNumber, PageButton in pairs(PageButtons) do

		if PageNumber == Page then
			PageButton.BackgroundColor3 =
				Color3.fromRGB(60,120,220)
		else
			PageButton.BackgroundColor3 =
				Color3.fromRGB(40,40,40)
		end
	end
end

