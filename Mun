--// إنشاء تبويب واحد عند طلبه
function Library:CreateTab(name)
    assert(not self.Tabs[name], "Tab already exists: " .. name)

    local index = 0
    for _ in pairs(self.Tabs) do
        index += 1
    end

    local TabButton = New("TextButton", {
        Name = name .. "Button",
        Size = UDim2.new(0, 100, 1, 0),
        BackgroundColor3 = Color3.fromRGB(32, 32, 43),
        Text = name,
        TextColor3 = Color3.new(1, 1, 1),
        Font = Enum.Font.GothamBold,
        TextSize = 13,
        AutoButtonColor = false,
        LayoutOrder = index + 1,
        ZIndex = 6
    }, TabBar)
    Round(TabButton, 8)

    local Page = New("ScrollingFrame", {
        Name = name .. "Page",
        Size = UDim2.fromScale(1, 1),
        BackgroundTransparency = 1,
        BorderSizePixel = 0,
        ScrollBarThickness = 3,
        ScrollBarImageColor3 = Color3.fromRGB(255, 50, 100),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        CanvasSize = UDim2.new(0, 0, 0, 0),
        Visible = false,
        ZIndex = 5
    }, Pages)

    New("UIPadding", {
        PaddingTop = UDim.new(0, 5),
        PaddingBottom = UDim.new(0, 8),
        PaddingLeft = UDim.new(0, 3),
        PaddingRight = UDim.new(0, 3)
    }, Page)

    New("UIListLayout", {
        Padding = UDim.new(0, 8),
        SortOrder = Enum.SortOrder.LayoutOrder
    }, Page)

    local order = 0
    local API = {}

    local function AddOrder(object)
        order += 1
        object.LayoutOrder = order
        return object
    end

    local function Select()
        for _, tab in pairs(Library.Tabs) do
            tab.Page.Visible = false
            Tween(tab.Button, {
                BackgroundColor3 = Color3.fromRGB(32, 32, 43)
            }, 0.12)
        end

        Page.Visible = true
        Tween(TabButton, {
            BackgroundColor3 = Color3.fromRGB(150, 35, 65)
        }, 0.12)
    end

    function API:AddSection(text)
        local section = New("TextLabel", {
            Size = UDim2.new(1, -2, 0, 30),
            BackgroundTransparency = 1,
            Text = "— " .. text .. " —",
            TextColor3 = Color3.fromRGB(255, 90, 125),
            Font = Enum.Font.GothamBold,
            TextSize = 14,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 6
        }, Page)
        return AddOrder(section)
    end

    function API:AddLabel(text)
        local label = New("TextLabel", {
            Size = UDim2.new(1, -2, 0, 32),
            BackgroundColor3 = Color3.fromRGB(25, 25, 34),
            Text = "  " .. tostring(text),
            TextColor3 = Color3.fromRGB(225, 225, 235),
            Font = Enum.Font.Gotham,
            TextSize = 13,
            TextWrapped = true,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 6
        }, Page)
        Round(label, 7)
        return AddOrder(label)
    end

    function API:AddButton(options)
        options = options or {}

        local button = New("TextButton", {
            Size = UDim2.new(1, -2, 0, 40),
            BackgroundColor3 = Color3.fromRGB(30, 30, 41),
            Text = options.Name or "Button",
            TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.GothamBold,
            TextSize = 13,
            AutoButtonColor = false,
            ZIndex = 6
        }, Page)

        Round(button, 8)
        Stroke(button, Color3.fromRGB(75, 75, 95), 1)
        AddOrder(button)

        button.Activated:Connect(function()
            Tween(button, {
                BackgroundColor3 = Color3.fromRGB(110, 35, 65)
            }, 0.08)

            task.delay(0.12, function()
                if button.Parent then
                    Tween(button, {
                        BackgroundColor3 = Color3.fromRGB(30, 30, 41)
                    }, 0.15)
                end
            end)

            if typeof(options.Callback) == "function" then
                local ok, err = pcall(options.Callback)
                if not ok then
                    warn("[NOVA Button]", err)
                end
            end
        end)

        return button
    end

    function API:AddToggle(options)
        options = options or {}
        local state = options.Default == true

        local frame = New("Frame", {
            Size = UDim2.new(1, -2, 0, 42),
            BackgroundColor3 = Color3.fromRGB(25, 25, 34),
            ZIndex = 6
        }, Page)
        Round(frame, 8)
        AddOrder(frame)

        New("TextLabel", {
            Position = UDim2.fromOffset(10, 0),
            Size = UDim2.new(1, -72, 1, 0),
            BackgroundTransparency = 1,
            Text = options.Name or "Toggle",
            TextColor3 = Color3.new(1, 1, 1),
            Font = Enum.Font.Gotham,
            TextSize = 13,
            TextXAlignment = Enum.TextXAlignment.Left,
            ZIndex = 7
        }, frame)

        local switch = New("TextButton", {
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, -8, 0.5, 0),
            Size = UDim2.fromOffset(48, 24),
            BackgroundColor3 = Color3.fromRGB(80, 80, 90),
            Text = "",
            AutoButtonColor = false,
            ZIndex = 7
        }, frame)
        Round(switch, 12)

        local knob = New("Frame", {
            Position = UDim2.fromOffset(3, 3),
            Size = UDim2.fromOffset(18, 18),
            BackgroundColor3 = Color3.new(1, 1, 1),
            ZIndex = 8
        }, switch)
        Round(knob, 10)

        local function Set(value, callCallback)
            state = value == true

            Tween(switch, {
                BackgroundColor3 = state
                    and Color3.fromRGB(30, 190, 100)
                    or Color3.fromRGB(80, 80, 90)
            }, 0.15)

            Tween(knob, {
                Position = state
                    and UDim2.new(1, -21, 0, 3)
                    or UDim2.fromOffset(3, 3)
            }, 0.15)

            if callCallback ~= false
            and typeof(options.Callback) == "function" then
                local ok, err = pcall(options.Callback, state)
                if not ok then
                    warn("[NOVA Toggle]", err)
                end
            end
        end

        switch.Activated:Connect(function()
            Set(not state, true)
        end)

        Set(state, false)

        return {
            Set = function(_, value)
                Set(value, true)
            end,
            Get = function()
                return state
            end
        }
    end

    API.Page = Page
    API.Button = TabButton
    API.Select = Select

    Library.Tabs[name] = API
    TabButton.Activated:Connect(Select)

    if index == 0 then
        Select()
    end

    return API
end

