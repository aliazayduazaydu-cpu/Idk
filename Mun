local function UpdateBank()
    local value

    local leaderstats = Player:FindFirstChild("leaderstats")
    if leaderstats then
        local bank = leaderstats:FindFirstChild("Bank")
        if bank and (
            bank:IsA("IntValue")
            or bank:IsA("NumberValue")
            or bank:IsA("StringValue")
        ) then
            value = bank.Value
        end
    end

    if value == nil then
        value = Player:GetAttribute("Bank")
    end

    BankLabel.Text = "  Bank: " ..
        (value ~= nil and tostring(value) or "غير متوفر")
end

local frames = 0
local lastUpdate = os.clock()

local fpsConnection = RunService.RenderStepped:Connect(function()
    frames += 1

    local now = os.clock()
    if now - lastUpdate >= 1 then
        FPSLabel.Text = "  FPS: " .. tostring(frames)
        frames = 0
        lastUpdate = now
    end
end)
table.insert(Library.Connections, fpsConnection)

task.spawn(function()
    while ScreenGui.Parent do
        local ping = "غير متوفر"

        local ok, result = pcall(function()
            return Stats.Network.ServerStatsItem["Data Ping"]:GetValueString()
        end)

        if ok and result then
            ping = tostring(result)
        end

        PingLabel.Text = "  Ping: " .. ping
        UpdateBank()

        task.wait(2)
    end
end)

