plr.Chatted:Connect(function(msg)
    local args = string.split(string.lower(msg), " ")
    local cmd = args[1]
    
    if cmd == "؛طيران" then
        if args[2] and tonumber(args[2]) then
            speed = tonumber(args[2])
            speedInput.Text = tostring(speed)
        end
        if not noclipActive then setFlyState(true) end
    elseif cmd == "؛عدم" then
        if noclipActive then setFlyState(false) end
    elseif cmd == "؛اختراق" then
        setNoclipState(true)
    elseif cmd == "؛ايقاف" or cmd == ";unnoclip" then
        setNoclipState(false)
    end
end)

speedInput.FocusLost:Connect(function()
    local num = tonumber(speedInput.Text)
    if num then speed = num speedInput.Text = tostring(speed) end
end)

