    ClickSound:Play()
end

--============================================================
-- BUTTON FUNCTION
--============================================================

local function AddButton(Section, Name, Code)
    Section:AddButton({
        Name = Name,
        Callback = function()
            PlaySound()

            --================================================
            -- حط كود الزر هنا
            --================================================

            if Code then
                Code()
            end
        end
    })
end

