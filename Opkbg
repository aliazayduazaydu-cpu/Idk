--==================================================
-- ⛔ STOP CURRENT
--==================================================

local function StopCurrent()

	if CurrentTrack then

		if CurrentTrack.IsPlaying then
			CurrentTrack:Stop(0.12)
		end

		CurrentTrack = nil

	end

end

--==================================================
-- ▶️ PLAY ANIMATION
--==================================================

local function PlayAnimation(Track)

	if not Enabled then
		return
	end

	if not Track then
		return
	end

	if CurrentTrack == Track and Track.IsPlaying then
		return
	end

	StopCurrent()

	CurrentTrack = Track
	Track:Play(0.12)

end

--==================================================
-- 🔄 LOAD ANIMATIONS
--==================================================

local function LoadAnimations()

	if not Animator then
		return
	end

	StopCurrent()

	for _, Track in pairs(Tracks) do

		pcall(function()
			Track:Stop()
			Track:Destroy()
		end)

	end

	Tracks = {}

	local Set = AnimationSets[SelectedSet]

	if not Set then
		return
	end

	for Name, ID in pairs(Set) do

		local Animation = Instance.new("Animation")
		Animation.Name = Name
		Animation.AnimationId = ID

		local Track = Animator:LoadAnimation(Animation)

		Track.Priority = Enum.AnimationPriority.Action

		if Name == "Idle"
			or Name == "Walk"
			or Name == "Run"
			or Name == "Fall"
			or Name == "Climb" then

			Track.Looped = true

		else

			Track.Looped = false

		end

		Tracks[Name] = Track

	end

end

--==================================================
-- 🎮 UPDATE ANIMATION
--==================================================

local function UpdateAnimation()

	if not Enabled then
		return
	end

	if not Humanoid then
		return
	end

	if Humanoid.Health <= 0 then
		return
	end

	local State = Humanoid:GetState()
	local Moving = Humanoid.MoveDirection.Magnitude > 0.05

	-- قفز
	if State == Enum.HumanoidStateType.Jumping then

		PlayAnimation(Tracks.Jump)
		return

	end

	-- سقوط
	if State == Enum.HumanoidStateType.Freefall then

		PlayAnimation(Tracks.Fall)
		return

	end

	-- تسلق / Clip
	if State == Enum.HumanoidStateType.Climbing then

		PlayAnimation(Tracks.Climb)
		return

	end

	-- مشي / ركض
	if Moving then

		if Humanoid.WalkSpeed >= RUN_SPEED then
			PlayAnimation(Tracks.Run)
		else
			PlayAnimation(Tracks.Walk)
		end

		return

	end

	-- وقوف
	PlayAnimation(Tracks.Idle)

end

--==================================================
-- 👤 CHARACTER
--==================================================

local function SetupCharacter(NewCharacter)

	Character = NewCharacter

	Humanoid = Character:WaitForChild("Humanoid")

	Animator = Humanoid:FindFirstChildOfClass("Animator")

	if not Animator then

		Animator = Instance.new("Animator")
		Animator.Parent = Humanoid

	end

	LoadAnimations()

	if StateConnection then
		StateConnection:Disconnect()
	end

	if RunningConnection then
		RunningConnection:Disconnect()
	end

	StateConnection = Humanoid.StateChanged:Connect(function()
		UpdateAnimation()
	end)

	RunningConnection = Humanoid.Running:Connect(function()
		UpdateAnimation()
	end)

	task.wait(0.2)

	if Enabled then
		PlayAnimation(Tracks.Idle)
	end

end

