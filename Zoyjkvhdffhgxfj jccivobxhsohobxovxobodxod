--==================== نظام Toggle ====================--
local state = false

local function setState(value)
	state = value
	local color = state and ON_COLOR or OFF_COLOR

	tween(stroke, 0.3, { Color = color })
	tween(dot, 0.3, { BackgroundColor3 = color })
	tween(label, 0.3, { TextColor3 = color })
	label.Text = BUTTON_TEXT .. (state and ": ON" or ": OFF")

	-- حركة نبضة
	scale.Scale = 0.85
	tween(scale, 0.35, { Scale = 1 }, Enum.EasingStyle.Back)

	sound:Play()

	task.spawn(function()
		local ok, err = pcall(OnToggle, state)
		if not ok then warn("خطأ في سكربت Toggle: " .. tostring(err)) end
	end)
end

--==================== السحب + الضغط ====================--
local dragging, dragStart, startPos, moved = false, nil, nil, false

button.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		moved = false
		dragStart = input.Position
		startPos = button.Position
		tween(scale, 0.1, { Scale = 0.9 })

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
				tween(scale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
				if not moved then
					setState(not state)
				end
			end
		end)
	end
end)

UIS.InputChanged:Connect(function(input)
	if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
		local delta = input.Position - dragStart
		if delta.Magnitude > 6 then moved = true end
		if moved then
			tween(button, 0.08, {
				Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
			})
		end
	end
end)

button.MouseEnter:Connect(function()
	tween(scale, 0.2, { Scale = 1.08 }, Enum.EasingStyle.Back)
end)
button.MouseLeave:Connect(function()
	tween(scale, 0.2, { Scale = 1 })
end)
