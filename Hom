--// Rainbow helper
local function toggleRainbow(key, label, callback, button)
    rainbow[key] = not rainbow[key]
    local active = rainbow[key]

    button.Text = label .. (active and " 🟢 ON" or " 🔴 OFF")
    status.Text = label .. (active and ": يعمل" or ": متوقف")

    if not active then
        return
    end

    task.spawn(function()
        while rainbow[key] do
            local color = Color3.fromHSV(math.random(), 1, 1)

            local success, err = pcall(function()
                callback(color)
            end)

            if not success then
                rainbow[key] = false
                button.Text = label .. " 🔴 OFF"
                status.Text = "تعذر تشغيل " .. label
                warn(err)
                break
            end

            task.wait(0.5)
        end
    end)
end

