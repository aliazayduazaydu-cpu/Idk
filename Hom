local function addAction(text, callback)
    local button = Instance.new("TextButton")
    button.Size = UDim2.new(1, -5, 0, 43)
    button.BackgroundColor3 = Color3.fromRGB(40, 30, 53)
    button.Text = text
    button.TextColor3 = Color3.new(1, 1, 1)
    button.TextSize = 14
    button.Font = Enum.Font.GothamBold
    button.Parent = list

    addCorner(button, 8)
    addStroke(button, Color3.fromRGB(125, 35, 180))

    button.Activated:Connect(callback)
    return button
end

local function sendRequest(label, callback)
    local success, err = pcall(callback)

    if success then
        status.Text = "تم إرسال طلب: " .. label
    else
        status.Text = "تعذر إرسال: " .. label
        warn(err)
    end
end

