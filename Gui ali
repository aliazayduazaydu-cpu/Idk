--==================== فتح / غلق ====================--
local isOpen = false
local busy = false
local hue = 0

local function setOpen(state)
	if busy or state == isOpen then return end
	busy = true
	isOpen = state

	if state then
		menu.Visible = true
		menuScale.Scale = 0
		for _, s in ipairs(buttonScales) do s.Scale = 0 end

		tween(menuScale, 0.5, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
		for i, s in ipairs(buttonScales) do
			task.delay(0.12 + i * 0.06, function()
				if isOpen then
					tween(s, 0.4, { Scale = 1 }, Enum.EasingStyle.Back, Enum.EasingDirection.Out)
				end
			end)
		end

		toggle.Rotation = 0
		local r = tween(toggle, 0.5, { Rotation = 360 }, Enum.EasingStyle.Quint)
		r.Completed:Connect(function() toggle.Rotation = 0 end)
		task.delay(0.5, function() busy = false end)
	else
		local t = tween(menuScale, 0.35, { Scale = 0 }, Enum.EasingStyle.Back, Enum.EasingDirection.In)
		t.Completed:Connect(function()
			if not isOpen then menu.Visible = false end
			busy = false
		end)

		toggle.Rotation = 0
		local r = tween(toggle, 0.4, { Rotation = -360 }, Enum.EasingStyle.Quint)
		r.Completed:Connect(function() toggle.Rotation = 0 end)
	end
end

