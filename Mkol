--============================================================
-- SPIN
--============================================================

local SpinConnection

local function StopSpin()
	if SpinConnection then
		SpinConnection:Disconnect()
		SpinConnection = nil
	end

	if Humanoid then
		Humanoid.AutoRotate = true
	end
end

local function StartSpin(Speed)
	StopSpin()

	if not RootPart or not Humanoid then
		return
	end

	Humanoid.AutoRotate = false

	local RotationSpeed = math.rad(Speed)

	SpinConnection = RunService.RenderStepped:Connect(function(dt)
		if not RootPart or not RootPart.Parent then
			StopSpin()
			return
		end

		RootPart.CFrame =
			RootPart.CFrame *
			CFrame.Angles(0, RotationSpeed * dt, 0)
	end)
end

--============================================================
-- DANCE
--============================================================

local DanceTrack = nil

local DanceEmotes = {
	"dance",
	"dance2",
	"dance3"
}

local function StopDance()
	if DanceTrack then
		pcall(function()
			DanceTrack:Stop(0.15)
		end)

		DanceTrack = nil
	end
end

local function StartDance()
	StopDance()
	UpdateCharacter()

	if not Humanoid then
		return
	end

	-- تجربة الرقصات الأساسية
	local EmoteName =
		DanceEmotes[
			math.random(1, #DanceEmotes)
		]

	local Success = false

	pcall(function()
		Success = Humanoid:PlayEmote(EmoteName)
	end)

	-- إذا اشتغل الإيموت، نحاول نخليه مستمر
	if Success then
		task.wait(0.15)

		local Animator =
			Humanoid:FindFirstChildOfClass("Animator")

		if Animator then
			local Tracks =
				Animator:GetPlayingAnimationTracks()

			for _, Track in ipairs(Tracks) do
				if Track.IsPlaying then
					DanceTrack = Track

					pcall(function()
						Track.Looped = true
						Track.Priority =
							Enum.AnimationPriority.Action
					end)

					break
				end
			end
		end
	end
end

--============================================================
-- RESET
--============================================================

local function ResetPlayer()
	StopSpin()
	StopDance()

	if not Character or not Character.Parent then
		UpdateCharacter()
	end

	if Humanoid then
		Humanoid.WalkSpeed = NORMAL_SPEED
		Humanoid.UseJumpPower = true
		Humanoid.JumpPower = NORMAL_JUMP
		Humanoid.AutoRotate = true
	end

	workspace.Gravity = NORMAL_GRAVITY

	if RootPart then
		RootPart.AssemblyAngularVelocity = Vector3.zero
	end
end

--============================================================
-- FLING
--============================================================

local function DoFling()
	UpdateCharacter()

	if RootPart then
		local X = math.random(-180, 180)
		local Y = math.random(100, 180)
		local Z = math.random(-180, 180)

		RootPart.AssemblyLinearVelocity =
			Vector3.new(X, Y, Z)
	end
end

--============================================================
-- TRIP
--============================================================

local function DoTrip()
	UpdateCharacter()

	if Humanoid then
		Humanoid:ChangeState(
			Enum.HumanoidStateType.FallingDown
		)
	end
end

--============================================================
-- TELEPORT RANDOM PLAYER
--============================================================

local function TeleportRandomPlayer()
	UpdateCharacter()

	local AvailablePlayers = {}

	for _, OtherPlayer in ipairs(Players:GetPlayers()) do
		if OtherPlayer ~= Player then

			local OtherCharacter =
				OtherPlayer.Character

			if OtherCharacter then

				local OtherRoot =
					OtherCharacter:FindFirstChild(
						"HumanoidRootPart"
					)

				if OtherRoot then
					table.insert(
						AvailablePlayers,
						OtherPlayer
					)
				end
			end
		end
	end

	if #AvailablePlayers == 0 then
		return "📍 لا يوجد لاعب"
	end

	local Target =
		AvailablePlayers[
			math.random(
				1,
				#AvailablePlayers
			)
		]

	local TargetRoot =
		Target.Character:FindFirstChild(
			"HumanoidRootPart"
		)

	if TargetRoot and RootPart then

		RootPart.CFrame =
			TargetRoot.CFrame +
			Vector3.new(0, 3, 0)

		return "📍 " .. Target.DisplayName
	end

	return "📍 فشل الانتقال"
end

--============================================================
-- TIMER
--============================================================

local function RunTimer(Duration)

	local StartTime = tick()

	while true do

		local Elapsed =
			tick() - StartTime

		local Remaining =
			Duration - Elapsed

		if Remaining <= 0 then
			break
		end

		TimerText.Text =
			string.format("%.1f", Remaining)

		local Percent =
			Remaining / Duration

		Bar.Size =
			UDim2.new(
				Percent,
				0,
				1,
				0
			)

		task.wait(0.05)
	end

	TimerText.Text = "0"

	Bar.Size =
		UDim2.new(
			1,
			0,
			1,
			0
		)

	Bar.BackgroundColor3 =
		Color3.fromRGB(
			75,
			75,
			75
		)
end

--============================================================
-- RANDOM DISASTER
--============================================================

local function GetRandomDisaster()

	local Events = {
		"Speed",
		"Jump",
		"Gravity",
		"Spin",
		"FlingTrip",
		"Teleport",
		"Dance"
	}

	return Events[
		math.random(
			1,
			#Events
		)
	]
end

--============================================================
-- START DISASTER
--============================================================

local function StartDisaster()

	UpdateCharacter()

	local Event =
		GetRandomDisaster()

	local Duration = 30
	local Name = ""

	--========================================================
	-- SPEED
	--========================================================

	if Event == "Speed" then

		local Value =
			SpeedValues[
				math.random(
					1,
					#SpeedValues
				)
			]

		Humanoid.WalkSpeed = Value

		Name =
			"⚡ سرعة: " .. Value

	--========================================================
	-- JUMP
	--========================================================

	elseif Event == "Jump" then

		local Value =
			JumpValues[
				math.random(
					1,
					#JumpValues
				)
			]

		Humanoid.UseJumpPower = true
		Humanoid.JumpPower = Value

		Name =
			"🦘 قفز: " .. Value

	--========================================================
	-- GRAVITY
	--========================================================

	elseif Event == "Gravity" then

		local Value =
			GravityValues[
				math.random(
					1,
					#GravityValues
				)
			]

		workspace.Gravity = Value

		Name =
			"🌍 جاذبية: " .. Value

	--========================================================
	-- SPIN
	--========================================================

	elseif Event == "Spin" then

		local Value =
			math.random(
				10,
				50
			)

		StartSpin(Value)

		Name =
			"🌀 دوران: " .. Value

	--========================================================
	-- FLING / TRIP
	--========================================================

	elseif Event == "FlingTrip" then

		Duration = 5

		local Choice =
			math.random(
				1,
				2
			)

		if Choice == 1 then

			DoFling()

			Name =
				"💨 Fling"

		else

			DoTrip()

			Name =
				"🦶 Trip"
		end

	--========================================================
	-- TELEPORT
	--========================================================

	elseif Event == "Teleport" then

		Name =
			TeleportRandomPlayer()

	--========================================================
	-- DANCE
	--========================================================

	elseif Event == "Dance" then

		StartDance()

		Name =
			"💃 رقص"
	end

	--========================================================
	-- START DISASTER TIMER
	--========================================================

	DisasterText.Text = Name

	Bar.Size =
		UDim2.new(
			1,
			0,
			1,
			0
		)

	RunTimer(Duration)

	--========================================================
	-- RESET
	--========================================================

	ResetPlayer()

	DisasterText.Text =
		"⏳ الكارثة القادمة"

	Bar.Size =
		UDim2.new(
			1,
			0,
			1,
			0
		)
end

--============================================================
-- MAIN LOOP
--============================================================

task.spawn(function()

	while true do

		ResetPlayer()

		DisasterText.Text =
			"⏳ الكارثة القادمة"

		Bar.Size =
			UDim2.new(
				1,
				0,
				1,
				0
			)

		-- 40 ثانية قبل الكارثة
		RunTimer(WAIT_TIME)

		-- تشغيل الكارثة
		StartDisaster()

		task.wait(0.5)
	end
end)
