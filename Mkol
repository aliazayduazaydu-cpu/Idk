--============================================================
-- RAINBOW
--============================================================

local function RainbowColor(Offset)

	local Hue =
		(tick() * 0.25 + Offset) % 1

	return Color3.fromHSV(
		Hue,
		1,
		1
	)

end

--============================================================
-- CREATE DISASTER TEXT
--============================================================

local function CreateDisasterText(Disaster)

	local Text = Instance.new("TextLabel")

	Text.Name =
		"Disaster_" .. Disaster.ID

	Text.Size =
		UDim2.new(1, 0, 0, 25)

	Text.BackgroundTransparency = 1

	Text.Text =
		Disaster.Name ..
		" (" ..
		string.format(
			"%.2f",
			DISASTER_TIME
		) ..
		")"

	Text.TextColor3 =
		Color3.new(1, 1, 1)

	Text.TextStrokeTransparency = 0.35

	Text.TextSize = 16

	Text.Font =
		Enum.Font.GothamBold

	Text.TextXAlignment =
		Enum.TextXAlignment.Right

	Text.Parent =
		DisasterContainer

	Disaster.Text = Text

end

--============================================================
-- MAP HIDE
--============================================================

local HiddenParts = {}

local function HideMapPart(Part)

	if not Part:IsA("BasePart") then
		return
	end

	-- لا نخفي شخصية اللاعب
	if Character and Part:IsDescendantOf(Character) then
		return
	end

	-- لا نخفي شخصيات اللاعبين
	for _, OtherPlayer in
		ipairs(Players:GetPlayers()) do

		if OtherPlayer.Character
			and Part:IsDescendantOf(
				OtherPlayer.Character
			) then

			return
		end

	end

	if HiddenParts[Part] == nil then

		HiddenParts[Part] =
			Part.LocalTransparencyModifier

	end

	Part.LocalTransparencyModifier =
		MAP_TRANSPARENCY

end

local function HideMap()

	for _, Object in
		ipairs(workspace:GetDescendants()) do

		HideMapPart(Object)

	end

end

local function RestoreMap()

	for Part, OldValue in
		pairs(HiddenParts) do

		if Part
			and Part.Parent then

			Part.LocalTransparencyModifier =
				OldValue

		end

	end

	table.clear(HiddenParts)

end

--============================================================
-- BASIC RESET
--============================================================

local function ResetProperties()

	UpdateCharacter()

	if Humanoid then

		Humanoid.WalkSpeed =
			NORMAL_SPEED

		Humanoid.UseJumpPower =
			true

		Humanoid.JumpPower =
			NORMAL_JUMP

	end

	workspace.Gravity =
		NORMAL_GRAVITY

end

--============================================================
-- APPLY ACTIVE EFFECTS
--============================================================

local function ApplyEffects()

	UpdateCharacter()

	if not Humanoid then
		return
	end

	local SpeedValue = nil
	local JumpValue = nil
	local GravityValue = nil

	local NoJump = false
	local HasReverse = false
	local HasMapHide = false

	for _, Disaster in
		ipairs(ActiveDisasters) do

		if Disaster.Type == "Speed" then

			SpeedValue =
				Disaster.Value

		elseif Disaster.Type == "Jump" then

			JumpValue =
				Disaster.Value

		elseif Disaster.Type == "Gravity" then

			GravityValue =
				Disaster.Value

		elseif Disaster.Type == "NoJump" then

			NoJump = true

		elseif Disaster.Type == "Reverse" then

			HasReverse = true

		elseif Disaster.Type == "MapHide" then

			HasMapHide = true

		end

	end

	--========================================================
	-- SPEED
	--========================================================

	if SpeedValue then

		Humanoid.WalkSpeed =
			SpeedValue

	else

		Humanoid.WalkSpeed =
			NORMAL_SPEED

	end

	--========================================================
	-- JUMP
	--========================================================

	if NoJump then

		Humanoid.UseJumpPower =
			true

		Humanoid.JumpPower =
			0

	elseif JumpValue then

		Humanoid.UseJumpPower =
			true

		Humanoid.JumpPower =
			JumpValue

	else

		Humanoid.UseJumpPower =
			true

		Humanoid.JumpPower =
			NORMAL_JUMP

	end

	--========================================================
	-- GRAVITY
	--========================================================

	if GravityValue ~= nil then

		workspace.Gravity =
			GravityValue

	else

		workspace.Gravity =
			NORMAL_GRAVITY

	end

	--========================================================
	-- MAP
	--========================================================

	if HasMapHide then

		HideMap()

	else

		RestoreMap()

	end

end

--============================================================
-- TELEPORT
--============================================================

local function TeleportRandomPlayer()

	UpdateCharacter()

	if not RootPart then
		return
	end

	local AvailablePlayers = {}

	for _, OtherPlayer in
		ipairs(Players:GetPlayers()) do

		if OtherPlayer ~= Player then

			local OtherCharacter =
				OtherPlayer.Character

			if OtherCharacter then

				local OtherRoot =
					OtherCharacter:FindFirstChild(
						"HumanoidRootPart"
					)

				if OtherRoot then

					table.insert(
						AvailablePlayers,
						OtherPlayer
					)

				end

			end

		end

	end

	if #AvailablePlayers == 0 then
		return
	end

	local Target =
		AvailablePlayers[
			math.random(
				1,
				#AvailablePlayers
			)
		]

	local TargetCharacter =
		Target.Character

	if not TargetCharacter then
		return
	end

	local TargetRoot =
		TargetCharacter:FindFirstChild(
			"HumanoidRootPart"
		)

	if TargetRoot then

		RootPart.CFrame =
			TargetRoot.CFrame +
			Vector3.new(0, 3, 0)

	end

end

--============================================================
-- FLING
--============================================================

local function DoFling()

	UpdateCharacter()

	if RootPart then

		RootPart.AssemblyLinearVelocity =
			Vector3.new(
				math.random(-180, 180),
				math.random(100, 180),
				math.random(-180, 180)
			)

	end

end

--============================================================
-- TRIP
--============================================================

local function DoTrip()

	UpdateCharacter()

	if Humanoid then

		Humanoid:ChangeState(
			Enum.HumanoidStateType.FallingDown
		)

	end

end

--============================================================
-- REVERSE CONTROL
--============================================================

local function StartReverse(Disaster)

	Disaster.Connection =
		RunService.RenderStepped:Connect(
			function()

				if Disaster.Removed then
					return
				end

				if not Humanoid then
					return
				end

				local Direction =
					Humanoid.MoveDirection

				if Direction.Magnitude > 0.05 then

					Humanoid:Move(
						-Direction,
						false
					)

				end

			end
		)

end

--============================================================
-- REMOVE DISASTER
--============================================================

local function RemoveDisaster(Disaster)

	if Disaster.Removed then
		return
	end

	Disaster.Removed = true

	if Disaster.Connection then

		Disaster.Connection:Disconnect()

		Disaster.Connection = nil

	end

	if Disaster.Text then

		Disaster.Text:Destroy()

	end

	for i, Item in
		ipairs(ActiveDisasters) do

		if Item == Disaster then

			table.remove(
				ActiveDisasters,
				i
			)

			break

		end

	end

	ResetProperties()

	ApplyEffects()

end

--============================================================
-- RANDOM DISASTER
--============================================================

local function GetRandomDisaster()

	return {

		"Speed",
		"Jump",
		"Gravity",
		"FlingTrip",
		"Teleport",
		"Reverse",
		"NoJump",
		"MapHide"

	}

end

--============================================================
-- START DISASTER
--============================================================

local function StartDisaster()

	UpdateCharacter()

	-- إذا كان هناك 3 كوارث
	-- نحذف أقدم كارثة
	if #ActiveDisasters >= MAX_DISASTERS then

		RemoveDisaster(
			ActiveDisasters[1]
		)

	end

	DisasterID += 1

	local Events =
		GetRandomDisaster()

	local Event =
		Events[
			math.random(
				1,
				#Events
			)
		]

	local Disaster = {

		ID = DisasterID,

		Type = Event,

		Started =
			tick(),

		Expires =
			tick() +
			DISASTER_TIME,

		Removed = false,

		Value = nil,

		Name = "كارثة"

	}

	--========================================================
	-- SPEED
	--========================================================

	if Event == "Speed" then

		Disaster.Value =
			SpeedValues[
				math.random(
					1,
					#SpeedValues
				)
			]

		Disaster.Name =
			"⚡ سرعة"

	--========================================================
	-- JUMP
	--========================================================

	elseif Event == "Jump" then

		Disaster.Value =
			JumpValues[
				math.random(
					1,
					#JumpValues
				)
			]

		Disaster.Name =
			"🦘 قفز"

	--========================================================
	-- GRAVITY
	--========================================================

	elseif Event == "Gravity" then

		Disaster.Value =
			GravityValues[
				math.random(
					1,
					#GravityValues
				)
			]

		Disaster.Name =
			"🌍 جاذبية"

	--========================================================
	-- FLING / TRIP
	--========================================================

	elseif Event == "FlingTrip" then

		if math.random(1, 2) == 1 then

			DoFling()

			Disaster.Name =
				"💨 دفع"

		else

			DoTrip()

			Disaster.Name =
				"🦶 تعثر"

		end

	--========================================================
	-- TELEPORT
	--========================================================

	elseif Event == "Teleport" then

		TeleportRandomPlayer()

		Disaster.Name =
			"📍 انتقال"

	--========================================================
	-- REVERSE
	--========================================================

	elseif Event == "Reverse" then

		Disaster.Name =
			"🔄 تحكم معكوس"

	--========================================================
	-- NO JUMP
	--========================================================

	elseif Event == "NoJump" then

		Disaster.Name =
			"🚫 عدم قفز"

	--========================================================
	-- MAP HIDE
	--========================================================

	elseif Event == "MapHide" then

		Disaster.Name =
			"👁️ إخفاء الماب"

	end

	table.insert(
		ActiveDisasters,
		Disaster
	)

	CreateDisasterText(
		Disaster
	)

	if Event == "Reverse" then

		StartReverse(
			Disaster
		)

	end

	ApplyEffects()

end

--============================================================
-- CHARACTER RESPAWN FIX
--============================================================

Player.CharacterAdded:Connect(
	function(NewCharacter)

		Character =
			NewCharacter

		Humanoid =
			NewCharacter:WaitForChild(
				"Humanoid"
			)

		RootPart =
			NewCharacter:WaitForChild(
				"HumanoidRootPart"
			)

		task.wait(0.2)

		-- إعادة تطبيق الكوارث
		ApplyEffects()

	end
)

--============================================================
-- NEW MAP PART FIX
--============================================================

workspace.DescendantAdded:Connect(
	function(Object)

		-- إذا كارثة إخفاء الماب شغالة
		for _, Disaster in
			ipairs(ActiveDisasters) do

			if Disaster.Type == "MapHide"
				and not Disaster.Removed then

				task.wait()

				HideMapPart(Object)

				break

			end

		end

	end
)

--============================================================
-- UPDATE DISASTER TIMERS
--============================================================

RunService.RenderStepped:Connect(
	function()

		local Now =
			tick()

		for i =
			#ActiveDisasters,
			1,
			-1 do

			local Disaster =
				ActiveDisasters[i]

			if Disaster.Removed then
				continue
			end

			local Remaining =
				Disaster.Expires -
				Now

			if Remaining <= 0 then

				RemoveDisaster(
					Disaster
				)

			else

				if Disaster.Text then

					Disaster.Text.Text =
						Disaster.Name ..
						" (" ..
						string.format(
							"%.2f",
							Remaining
						) ..
						")"

					Disaster.Text.TextColor3 =
						RainbowColor(
							Disaster.ID * 0.15
						)

				end

			end

		end

		TopTimer.TextColor3 =
			RainbowColor(0)

	end
)

--============================================================
-- MAIN 30 SECOND TIMER
--============================================================

task.spawn(
	function()

		while true do

			local Start =
				tick()

			while true do

				local Elapsed =
					tick() - Start

				local Remaining =
					SPAWN_TIME -
					Elapsed

				if Remaining <= 0 then
					break
				end

				TopTimer.Text =
					string.format(
						"%.1f",
						Remaining
					)

				task.wait(0.05)

			end

			TopTimer.Text = "0"

			StartDisaster()

			task.wait(0.2)

		end

	end
)
